# Local development uses Vite's /api proxy for JSON requests.
VITE_API_URL=/api

# OAuth starts on Laravel itself, outside the /api route prefix.
VITE_BACKEND_URL=http://localhost:8000

# Optional: put this in app/.env.development.local (not laravel/.env) to delay
# every frontend API request in development. Use it to preview page loaders and
# skeletons; it is ignored by production builds even if set.
# VITE_API_DELAY_MS=1000
