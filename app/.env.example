# Local development uses Vite's /api proxy for JSON requests.
VITE_API_URL=/api

# OAuth starts on Laravel itself, outside the /api route prefix.
VITE_BACKEND_URL=http://localhost:8000

# Optional: delay every frontend API request by this many milliseconds in
# development only. Use this to preview page loaders and skeletons; it is
# ignored by production builds even if set.
# VITE_API_DELAY_MS=1000
